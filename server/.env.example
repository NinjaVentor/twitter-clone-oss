PORT=8080

# 1. Supabase Transaction Pooler URI (Top navbar "Connect" button -> URI -> port 6543 -> replace YOUR_DB_PASSWORD)
DATABASE_URL=postgresql://postgres.nukrgommmxdedyydxgjg:YOUR_DB_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# 2. Project URL (Pre-filled)
SUPABASE_URL=https://nukrgommmxdedyydxgjg.supabase.co

# 3. Paste the "anon" "public" key here (Row 1 under Legacy anon, service_role API keys)
SUPABASE_ANON_KEY=PASTE_YOUR_ANON_PUBLIC_KEY_HERE

# 4. Paste the "service_role" "secret" key here (Row 2 - Click Reveal and copy)
# Used by the Go backend to delete media from Supabase Storage and perform admin cleanup
SUPABASE_SERVICE_ROLE_KEY=PASTE_YOUR_SERVICE_ROLE_SECRET_KEY_HERE

# 5. Optional: Legacy JWT Secret (If left empty, Go middleware automatically verifies tokens via SUPABASE_URL/auth/v1/user using SUPABASE_ANON_KEY or SUPABASE_SERVICE_ROLE_KEY)
SUPABASE_JWT_SECRET=

# 6. Local Docker Valkey
VALKEY_ADDR=localhost:6379
VALKEY_URL=redis://localhost:6379
